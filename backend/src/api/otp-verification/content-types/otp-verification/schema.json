{
  "kind": "collectionType",
  "collectionName": "otp_verifications",
  "info": { "singularName": "otp-verification", "pluralName": "otp-verifications", "displayName": "OTP Verification" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "otpPhoneNumber": { "type": "string" },
    "otpCode": { "type": "string", "required": true },
    "otpPurpose": { "type": "enumeration", "enum": ["registration", "login", "payment_phone"], "default": "login" },
    "otpExpiresAt": { "type": "datetime", "required": true },
    "otpAttempts": { "type": "integer", "default": 0 }
  }
}